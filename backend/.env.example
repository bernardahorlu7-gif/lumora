# ---- Server ----
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:4000

# ---- Database (PostgreSQL) ----
# Full connection string, e.g. from Railway/Render/Supabase:
DATABASE_URL=postgres://lumora_user:lumora_pass@localhost:5432/lumora_nexus
# Set to "true" only if your provider requires SSL (most managed hosts do)
DATABASE_SSL=false

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# ---- File storage ----
# "local" writes to ./uploads. "s3" requires the S3_* vars below (adapter is stubbed, see src/services/storage.js)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Email (SMTP) — PLACEHOLDER, fill in before enabling email notifications ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM="Lumora DeMoore Properties <no-reply@lumorademoore.com>"
# Set to "true" once the SMTP_* values above are real
EMAIL_ENABLED=false

# ---- Microsoft Teams — PLACEHOLDER, fill in before enabling Teams notifications ----
# Create in Teams: Channel -> ... -> Connectors -> Incoming Webhook
TEAMS_WEBHOOK_URL=
TEAMS_ENABLED=false

# ---- Company defaults used in quote calculations & PDFs ----
DEFAULT_CURRENCY=GHS
DEFAULT_TAX_RATE=0.15
DEFAULT_VAT_RATE=0.15
DEFAULT_NHIL_RATE=0.025
DEFAULT_GETFUND_RATE=0.025
DEFAULT_WITHHOLDING_RATE=0
DEFAULT_OVERHEAD_PCT=0.10
DEFAULT_PROFIT_PCT=0.12
DEFAULT_CONTINGENCY_PCT=0.05
DOWN_PAYMENT_WITH_MATERIALS_PCT=0.70
DOWN_PAYMENT_WITHOUT_MATERIALS_PCT=0.50
