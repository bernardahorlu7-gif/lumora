{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [{ "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": ["backend/**"] } }],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
