{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [{ "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": ["backend/**"] } }],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/login.html", "dest": "/backend/public/login.html" },
    { "src": "/documents.html", "dest": "/backend/public/documents.html" },
    { "src": "/invoice_builder.html", "dest": "/backend/public/invoice_builder.html" },
    { "src": "/portal.js", "dest": "/backend/public/portal.js" },
    { "src": "/staff_portal_dashboard/(.*)", "dest": "/backend/public/staff_portal_dashboard/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
